<?xml version="1.0" encoding="utf-8"?>
<!-- Botón de grabar: anillo blanco con círculo rojo; grabando, el círculo pasa a cuadrado. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="4dp" android:color="@color/white" /></shape></item>
            <item android:left="24dp" android:top="24dp" android:right="24dp" android:bottom="24dp">
                <shape android:shape="rectangle"><corners android:radius="5dp" /><solid android:color="@color/record" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="oval"><stroke android:width="4dp" android:color="@color/white" /></shape></item>
            <item android:left="9dp" android:top="9dp" android:right="9dp" android:bottom="9dp">
                <shape android:shape="oval"><solid android:color="@color/record" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
